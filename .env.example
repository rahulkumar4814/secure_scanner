# Copy to .env (never commit .env). Generate values with:  python scripts/setup_keys.py
# API keys are stored ONLY as SHA-256 hashes (comma-separated for multiple users per role).
SECURESCAN_VIEWER_KEY_HASHES=
SECURESCAN_SCANNER_KEY_HASHES=
SECURESCAN_APPROVER_KEY_HASHES=
SECURESCAN_SESSION_SECRET=
SECURESCAN_GITHUB_WEBHOOK_SECRET=

# Server
SECURESCAN_HOST=127.0.0.1
SECURESCAN_PORT=8000
SECURESCAN_HTTPS_ONLY_COOKIES=false

# Scanning
SECURESCAN_ALLOWED_SCAN_ROOT=./samples
SECURESCAN_ALLOWED_GIT_HOSTS=github.com
SECURESCAN_EXCLUDE_DIRS=
SECURESCAN_MAX_CONCURRENT_SCANS=2
SECURESCAN_TOOL_TIMEOUT_SECONDS=600

# AI (local Ollama only). Empty model = choose at runtime in the UI / CLI.
SECURESCAN_OLLAMA_BASE_URL=http://127.0.0.1:11434
SECURESCAN_OLLAMA_MODEL=
# Optional embedding model for vector RAG (e.g. nomic-embed-text). Empty = BM25 keyword retrieval.
SECURESCAN_OLLAMA_EMBED_MODEL=
SECURESCAN_LLM_MAX_FINDINGS=10
